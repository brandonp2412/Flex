#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
while IFS= read -r git_local_var; do
  unset "$git_local_var"
done < <(git rev-parse --local-env-vars)
task_id=$(pueue add --print-task-id --escape --label "Flex pre-commit quality" -- bash -c 'set -euo pipefail; dart format --output=none --set-exit-if-changed lib test integration_test; flutter analyze; flutter test')
pueue wait --quiet "$task_id"
if ! pueue log --json "$task_id" | jq -e --arg id "$task_id" '.[$id].task.status.Done.result == "Success"' >/dev/null; then
  pueue log --lines 50 "$task_id"
  exit 1
fi
